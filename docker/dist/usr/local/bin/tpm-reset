#!/bin/sh
cd /tmp

## kill TPM2 simulator
sudo pkill -9 swtpm

## remove TPM2 simulator state
if [ -e '/tmp/swtpm20' ]; then sudo rm -r /tmp/swtpm20; fi

## create TPM2 simulator state, including EK Cert and Platform Cert
sudo mkdir -p /tmp/swtpm20 \
&& sudo chown tss:root /tmp/swtpm20 \
&& sudo swtpm_setup --tpmstate /tmp/swtpm20 \
    --create-ek-cert --create-platform-cert --tpm2 --overwrite \
    > /dev/null

## start TPM2 simulator in background
sudo swtpm socket --tpm2 \
    --tpmstate dir=/tmp/swtpm20 \
    --server port=2321 \
    --ctrl type=tcp,port=2322 \
    --log file=/tmp/swtpm20.log \
    --flags not-need-init \
    --daemon \
    > /dev/null
sudo chmod a+r /tmp/swtpm20.log

## wait for TPM simulator to start
while ! pidof swtpm >> /dev/null ; do
    sleep 0.1
done
## additional sleep to compensate for the starting time of the TPM2 simulator
sleep 1

## execute TPM2 startup
tpm2_startup --clear --tcti='swtpm:host=localhost,port=2321'
